# Peer dependencies are checked, not waved through.
#
# This file used to say `legacy-peer-deps=true`, and four separate packages
# walked in through it: expo-linking from SDK 56, @maplibre/maplibre-react-native
# asking for React Native 0.80, react-native-mmkv 3 needing the New
# Architecture, and react-native itself six patches behind the Kotlin the build
# expected. Every one of them resolved fine for the web bundle and made the
# Android build impossible, and npm said nothing about any of them.
#
# With the flag gone, npm refuses a conflicting install at the moment it
# happens rather than four minutes into Gradle. Verified: the current tree
# installs clean under --strict-peer-deps.
#
# If a future dependency genuinely needs an override, add a `overrides` entry
# in package.json for that one package — do not reopen this door for all of
# them.
audit=false
fund=false
