{
  "expo": {
    "name": "Sliabh",
    "slug": "sliabh",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#060d1b"
    },
    "orientation": "portrait",
    "scheme": "sliabh",
    "userInterfaceStyle": "dark",
    "platforms": [
      "android",
      "web"
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Sliabh — Senderismo y trekking en Argentina",
      "shortName": "Sliabh",
      "description": "Sliabh: la plataforma de senderismo para explorar los Parques Nacionales de Argentina. Rutas y senderos con mapas 3D, GPS y mapas offline, planificación y guías de supervivencia.",
      "lang": "es",
      "themeColor": "#16a34a",
      "backgroundColor": "#060d1b"
    },
    "android": {
      "minSdkVersion": 26,
      "targetSdkVersion": 35,
      "compileSdkVersion": 35,
      "package": "com.sliabh.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.WAKE_LOCK"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#14532d"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "Sliabh usa tu ubicación para grabar el recorrido mientras caminás, incluso con la pantalla apagada.",
          "locationWhenInUsePermission": "Sliabh usa tu ubicación para mostrar dónde estás en el sendero y grabar tu recorrido."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
