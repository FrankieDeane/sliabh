{
  "expo": {
    "name": "Sliabh",
    "slug": "sliabh",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "sliabh",
    "userInterfaceStyle": "dark",
    "platforms": ["android", "web"],
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Sliabh",
      "shortName": "Sliabh",
      "description": "Explora la montaña con IA offline. Rutas, mapas y planificación para Patagonia y más.",
      "lang": "es",
      "themeColor": "#16a34a",
      "backgroundColor": "#060d1b"
    },
    "android": {
      "minSdkVersion": 26,
      "targetSdkVersion": 35,
      "compileSdkVersion": 35,
      "package": "com.sliabh.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#14532d"
      }
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
