# Supabase — get these from your Supabase project dashboard (Settings → API).
# Then run supabase/schema.sql once in the SQL Editor to create the tables.
# Until these are set, community features (reports/contributions) stay hidden
# and the app falls back to local-only mode — nothing breaks.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Ollama — default points to Android emulator host
# For web dev, use: http://localhost:11434
# EXPO_PUBLIC_OLLAMA_URL=http://localhost:11434
